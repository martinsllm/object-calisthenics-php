{
    "autoload": {
        "psr-4": {
            "App\\Calisthenics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Calisthenics\\Tests\\": "tests/"
        }
    },
    "require": {
        "ext-ds": "*",
        "phpunit/phpunit": "^9"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}